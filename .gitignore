# ── Rust ──
target/
sys.maxmanager-service

# المكتبة الأصلية للتطبيق: تولّدها CI في كل بناء (build.yml → JNI step).
# الالتزام بها في المستودع سيتجاوز الشيفرة المصدرية بشيفرة مجمّعة قديمة
# (مصيدة وقعنا فيها: كانت تُبنى في ci.yml دون أن تستهلكها حزمة الإصدار).
#
# وكان السطر يكمل: «libtermux.so مستثناة — تبعية مرفقة عمدًا». وقد بطلت الإضافة
# مع الأصل الذي كانت تخدمه: حُذفت `libtermux.so` وقاعدتها `jniLibs/` كلها في جولة
# تدقيق الأصل `PROVENANCE-01` (كود GPL-3.0 يُشحن في تطبيق Apache-2.0). فلا استثناء
# بعد اليوم، ولا مكتبة أصلية مقترنة في المستودع.
manager/app/src/main/jniLibs/*/libmaxmanager_native.so

# ── Android / Gradle ──
.gradle/
build/
app/build/
local.properties
.idea/
.kotlin/
*.iml
captures/
.cxx/

# ── نسخ احتياطية وحطام بناء ──
# كانت متعقَّبة: *.bak/*.backup داخل الشجرة (منها MainActivity.kt.bak) وسجلات البناء.
# القاعدة: نسخة قديمة من ملف لا تنتمي إلى جانب الملف الحقيقي.
*.bak
*.backup
*.log

# ── حالة الأدوات المحلية ──
# .serena/cache = LSP + تليمترى (سجلات وCSV)، وproject.local.yml/إعدادات .claude محلية لكل جهاز.
# .serena/project.yml يبقى متعقّبًا — هو إعداد المشروع المشترك لا حالة الجهاز.
# __pycache__ ينشأ من تشغيل أدوات tools/*.py — مخزّن مؤقت لا ينتمي للمستودع.
.serena/cache/
__pycache__/
.serena/project.local.yml
.claude/settings.local.json

# علامة أداة مزامنة محلية تُنشأ في جذر العمل. فارغة، وتخصّ هذا الجهاز وحده، وكانت
# تظهر في `git status` كملف غير متعقّب في كل مرة — وهو ضجيج لا يخصّ المستودع.
.maxmanager-sync-root

# ── شجرة Freebuff المحلية (ليست من المشروع) ──
# نسخة عمل وكيل Freebuff تُوضع محليًا للتطوير فقط، وليست جزءًا من MaxManager:
# حجمها ~٩٣٦ ميجابايت (معظمها node_modules) ولا تُلتزم ولا تُوزَّع مع الطلب.
# وُضعت خارج الشجرة، وهذه القاعدة حاجز يمنع عودتها إن أُعيد إنشاؤها داخل المشروع.
freebuff-src/

# ── مخرجات بناء تسرّبت إلى التتبّع (أُزيلت في تدقيق الأصل PROVENANCE-01) ──
#
# `nd/max/core/hardware/ThermalCurve.class` كان صنفًا مُصرَّفًا سُحب يدويًّا إلى **جذر**
# المستودع (لا إلى `manager/app/src/main/java/nd/max/...`)، و`META-INF/main.kotlin_module`
# بيانات Kotlin المُصرَّفة. لا مرجع لأيّ منهما في الشجرة، ولا يدخلان أي مجموعة مصادر —
# والجذر ليس جذر مصادر أصلًا، فوجودهما هناك حطام لا مصدر. يُمنعان من العودة.
/nd/
/META-INF/

# ── نظام التشغيل ──
.DS_Store
Thumbs.db

# ── مخزن المفاتيح: مادة توقيع لا مصدر (قاعدة المالك: لا أسرار في أي ملف متعقَّب) ──
#
# `manager/app/azenith.jks` كان متعقَّبًا، و`manager/app/build.gradle.kts` يقرأ كلمة مروره من
# البيئة (`KS_PWD`) لا من الملف — فالملف نفسه مادة توقيع تُسحب من الشجرة وتبقى على جهاز المالك.
# ⚠️ وهذا يمنع **الرجوع** من التتبّع، ولا يمحو **التاريخ**: النسخة القديمة تبقى في الالتزامات
# السابقة، ومحوها يحتاج إعادة كتابة تاريخ لا تُجرى إلا بإذن المالك الصريح.
*.jks
*.keystore
manager/app/azenith.jks

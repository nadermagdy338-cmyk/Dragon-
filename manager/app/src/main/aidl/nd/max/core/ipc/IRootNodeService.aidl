// عقد السلك بين التطبيق وعملية الجذر (RootNodeService).
//
// اسمٌ واحد لكل عملية على عقدة، ولا دالّتان تفعلان الشيء نفسه: كل مستدعٍ هنا يعرف ماذا يريد
// بالضبط (قراءة نصّ، وجود، كتابة، أسماء مجلّد)، فلا تُبنى على الطبقة العليا دلالات مخمَّنة.
//
// و`readTexts` (الدفعة) ليست ترفًا: كل نداء هنا معاملة binder كاملة، ومسح الحرارة يقرأ
// عقدتين لكل منطقة وعشرات المناطق ⇒ مئات المعاملات في الدورة الواحدة. الدفعة تُنزلها إلى واحدة،
// والقراءات داخلها تبقى قراءات ملفات محلية في عملية الجذر — لا معاملة لكل عقدة.
package nd.max.core.ipc;

interface IRootNodeService {
    /** نصّ العقدة مقصوصًا، أو `""` إن لم تُقرأ. */
    String readText(String path);

    /** قراءة عدة عقد في معاملة واحدة: القيمة `i` للمسار `i`، و`""` تعني «لم تُقرأ». */
    List<String> readTexts(in List<String> paths);

    /** هل توجد عقدة/مجلّد بهذا المسار؟ */
    boolean exists(String path);

    /** كتابة تُستبدل بها قيمة العقدة كاملة. `true` تعني أن الكتابة نُفّذت. */
    boolean writeText(String path, String value);

    /** أسماء محتوى مجلّد، مرتّبة؛ و`directoriesOnly` يحصرها في المجلّدات وحدها. */
    List<String> listNames(String path, boolean directoriesOnly);
}

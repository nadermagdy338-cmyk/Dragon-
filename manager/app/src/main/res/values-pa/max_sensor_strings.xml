<resources>
    <string name="max_sensor_title">ਇਸ ਡਿਵਾਈਸ ਦੁਆਰਾ ਸੂਚਿਤ ਕੀਤੇ ਗਏ ਸੈਂਸਰ</string>
    <string name="max_sensor_desc">ਪਲੇਟਫਾਰਮ ਆਪਣੇ ਖੁਦ ਦੇ ਹਾਰਡਵੇਅਰ ਬਾਰੇ ਕੀ ਐਲਾਨ ਕਰਦਾ ਹੈ, ਨਾਲ ਹੀ ਇੱਕ ਸੀਮਾਬੱਧ ਲਾਈਟ ਰੀਡਿੰਗ। ਕੋਈ ਕੈਲੀਬ੍ਰੇਸ਼ਨ ਅਤੇ ਕੋਈ ਸਿਹਤ ਸਕੋਰ ਨਹੀਂ: ਦੋਵਾਂ ਨੂੰ ਇੱਕ ਭੌਤਿਕ ਸੰਦਰਭ ਦੀ ਲੋੜ ਹੋਵੇਗੀ ਜੋ ਸਾਡੇ ਕੋਲ ਨਹੀਂ ਹੈ।</string>
    <string name="max_sensor_service">ਸੈਂਸਰ ਸੇਵਾ</string>
    <string name="max_sensor_service_unavailable">ਪਹੁੰਚਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ</string>
    <string name="max_sensor_count">ਸੈਂਸਰਾਂ ਨੇ ਰਿਪੋਰਟ ਦਿੱਤੀ</string>
    <string name="max_sensor_kinds">ਸ਼੍ਰੇਣੀਆਂ ਮੌਜੂਦ ਹਨ</string>
    <string name="max_sensor_wakeup">ਵੇਕ-ਅੱਪ ਸੈਂਸਰ (ਡਿਵਾਈਸ ਦੇ ਸੌਣ ਵੇਲੇ ਰਿਪੋਰਟ ਕਰੋ)</string>
    <string name="max_sensor_light">ਅੰਬੀਨਟ ਰੋਸ਼ਨੀ</string>
    <string name="max_sensor_unit_lux">lux</string>
    <string name="max_sensor_light_absent">ਇਹ ਡਿਵਾਈਸ ਲਾਈਟ ਸੈਂਸਰ ਦੀ ਰਿਪੋਰਟ ਨਹੀਂ ਕਰਦੀ ਹੈ</string>
    <string name="max_sensor_light_unreadable">ਟਾਈਮਆਉਟ ਤੋਂ ਪਹਿਲਾਂ ਕੋਈ ਰੀਡਿੰਗ ਨਹੀਂ ਆਈ — ਅਣਜਾਣ, ਜ਼ੀਰੋ ਨਹੀਂ</string>
    <string name="max_sensor_more">…ਅਤੇ %1$s ਹੋਰ</string>
    <string name="max_sensor_no_score">ਨਾਮ, ਰੇਂਜ ਅਤੇ ਦੇਰੀ ਪਲੇਟਫਾਰਮ ਤੋਂ ਆਉਂਦੀਆਂ ਹਨ। ਇੱਕ ਸੈਂਸਰ ਜੋ ਰਿਪੋਰਟ ਕਰਦਾ ਹੈ ਇਸਦਾ ਸਬੂਤ ਨਹੀਂ ਹੈ ਕਿ ਇਹ ਸਹੀ ਹੈ।</string>

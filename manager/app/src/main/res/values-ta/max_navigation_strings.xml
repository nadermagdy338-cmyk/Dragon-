    <string name="max_hub_cpu">CPU</string>
    <string name="max_hub_cpu_desc">கோர்கள், கவர்னர், விற்பனையாளர் பூஸ்ட் மற்றும் கர்னல் விருப்பத்தேர்வுகள்</string>
    <string name="max_hub_gpu">GPU</string>
    <string name="max_hub_gpu_desc">GPU அதிர்வெண்கள் மற்றும் கிராபிக்ஸ்-குறிப்பிட்ட விற்பனையாளர் அளவுருக்கள்</string>
    <string name="max_hub_memory">நினைவகம்</string>
    <string name="max_hub_memory_desc">சுருக்க, VM நடத்தை மற்றும் இடமாற்றம்</string>
    <string name="max_hub_display">காட்சி</string>
    <string name="max_hub_display_desc">புதுப்பிப்பு விகிதம், நிறம் மற்றும் கேன்வாஸ் அளவு</string>
    <string name="max_hub_responsiveness">பொறுப்புணர்வு</string>
    <string name="max_hub_responsiveness_desc">டச், ஃபிரேம் பேஸிங் மற்றும் திட்டமிடல் தாமதம்</string>
    <string name="max_hub_thermal">வெப்ப</string>
    <string name="max_hub_thermal_desc">வெப்பநிலை, த்ரோட்லிங் மற்றும் வெப்ப அளவுருக்கள்</string>
    <string name="max_hub_power">சக்தி</string>
    <string name="max_hub_power_desc">சார்ஜிங், பைபாஸ், தூக்கம் மற்றும் பேட்டரி ஆரோக்கியம்</string>
    <string name="max_hub_storage">சேமிப்பு &amp; தொகுப்பி</string>
    <string name="max_hub_storage_desc">தொகுத்தல் முறை மற்றும் சேமிப்பு ஆரோக்கியம்</string>
    <string name="max_hub_network">நெட்வொர்க்</string>
    <string name="max_hub_network_desc">போக்குவரத்து திட்டமிடல் மற்றும் இணைப்பு நிலை</string>
    <string name="max_hub_switches_title">நேரடி கட்டுப்பாடுகள்</string>
    <string name="max_config_backup_desc">உங்கள் MaxManager உள்ளமைவைச் சேமிக்கவும் அல்லது மீட்டெடுக்கவும்</string>
    <string name="max_config_backup_help">காப்புப்பிரதி கோப்பு நீங்கள் பயன்படுத்திய மாற்றங்களையும் உங்கள் ஒவ்வொரு ஆப்ஸ் அமைப்புகளையும் சேமிக்கிறது, எனவே நீங்கள் அவற்றை மற்றொரு ROM க்கு நகர்த்தலாம் அல்லது நன்கு அறியப்பட்ட நிலைக்குத் திரும்பலாம். மாற்றங்களை மீட்டமைக்க, காப்புப்பிரதி எடுக்கப்பட்ட அதே சிப்செட் தேவைப்படுகிறது; ஒவ்வொரு பயன்பாட்டிற்கும் அமைப்புகளை எப்போதும் மீட்டெடுக்க முடியும்.</string>
    <string name="max_config_backup_section">கட்டமைப்பு கோப்பு</string>
    <string name="max_config_backup_action">காப்புப்பிரதியை உருவாக்கவும்</string>
    <string name="max_config_backup_action_desc">நீங்கள் தேர்ந்தெடுக்கும் கோப்பில் உங்கள் உள்ளமைவை எழுதவும்</string>
    <string name="max_config_restore_action">காப்புப்பிரதியிலிருந்து மீட்டமைக்கவும்</string>
    <string name="max_config_restore_action_desc">முன்பு சேமித்த உள்ளமைவு கோப்பைப் படிக்கவும்</string>
    <string name="max_config_backup_scope_title">காப்புப்பிரதியில் என்ன இருக்கிறது</string>
    <string name="max_config_backup_scope_note">இந்தச் சாதனத்தின் ரூட் அணுகல் மற்றும் சிப்செட் எதையும் எழுதுவதற்கு முன் சரிபார்க்கப்படும்</string>

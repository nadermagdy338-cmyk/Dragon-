<!-- ترجمات مضافة — المصدر: values/max_plugins_strings.xml -->
<resources>
    <string name="max_plugins_title">타사 플러그인</string>
    <string name="max_plugins_subtitle">게시된 계약: 플러그인이 선언할 수 있는 내용과 여기에서 수락되거나 거부된 내용입니다.</string>
    <string name="max_plugins_section_contract">계약</string>
    <string name="max_plugins_contract_api">API 레벨 %1$d</string>
    <string name="max_plugins_contract_dir">매니페스트 폴더</string>
    <string name="max_plugins_contract_rules">선언된 기능은 읽기 또는 제안입니다. 의도적으로 하드웨어를 작성하는 기능은 없습니다. 이 앱의 모든 쓰기는 중재자를 거치며, 직접 쓸 수 있는 플러그인은 두 소유자가 동일한 노브를 작성하는 것을 막기 위해 내장된 가드를 제거합니다.</string>
    <string name="max_plugins_contract_keys">매니페스트에서 읽은 키</string>
    <string name="max_plugins_contract_kinds">허용되는 종류</string>
    <string name="max_plugins_contract_capabilities">허용되는 기능</string>
    <string name="max_plugins_template">매니페스트 템플릿</string>
    <string name="max_plugins_template_note">이 텍스트는 파서가 읽는 텍스트입니다. 코드에서 생성되기 때문에 코드에서 표류할 수 없습니다.</string>
    <string name="max_plugins_copy_template">템플릿 복사</string>
    <string name="max_plugins_template_copied">템플릿이 복사되었습니다.</string>
    <string name="max_plugins_section_installed">이 기기에서 발견됨</string>
    <string name="max_plugins_loading_title">플러그인 폴더 읽기</string>
    <string name="max_plugins_loading_detail">루트로 매니페스트 폴더를 나열한 다음 계약과 비교하여 각 매니페스트를 평가합니다.</string>
    <string name="max_plugins_accepted_count">%1$d 허용됨</string>
    <string name="max_plugins_rejected_count">%1$d 거절됨</string>
    <string name="max_plugins_unreadable_count">%1$d 읽을 수 있는 매니페스트가 없는 폴더</string>
    <string name="max_plugins_rejected_section">정확한 이유와 함께 거부됨</string>
    <string name="max_plugins_detail_label">선언됨</string>
    <string name="max_plugins_refresh_cd">플러그인 폴더를 다시 읽으세요</string>
    <string name="max_plugins_capability_source">우리가 측정하지 않은 플러그인에 의해 보고됨</string>
    <string name="max_plugins_cond_empty_title">플러그인이 설치되지 않았습니다.</string>
    <string name="max_plugins_cond_empty_detail">매니페스트 폴더에는 플러그인 폴더가 없습니다. 잘못된 것은 없습니다. 이것이 기능의 기본 상태입니다.</string>
    <string name="max_plugins_cond_missing_title">매니페스트 폴더가 아직 존재하지 않습니다.</string>
    <string name="max_plugins_cond_missing_detail">%1$s은(는) 이 기기에 생성되지 않았으므로 읽을 내용이 없습니다. 플러그인 작성자가 해야 할 일은 플러그인을 만드는 것뿐입니다.</string>
    <string name="max_plugins_cond_unreadable_title">매니페스트 폴더를 읽을 수 없습니다.</string>
    <string name="max_plugins_cond_unreadable_detail">폴더가 %1$s에 존재하지만 쉘이 이를 읽을 수 없습니다. 그것을 나열하려면 루트가 필요합니다.</string>
    <string name="max_plugins_reason_BadId">해당 ID는 폴더 이름으로 사용할 수 없습니다. 소문자 라틴 문자, 숫자, 점, 대시 또는 밑줄을 사용하고 두 개의 점을 연속해서 사용하지 마십시오.</string>
    <string name="max_plugins_reason_MissingName">매니페스트에는 이름이 선언되어 있지 않습니다.</string>
    <string name="max_plugins_reason_BadVersion">버전은 숫자로 시작해야 합니다(예: 1.0.0).</string>
    <string name="max_plugins_reason_ApiTooOld">선언된 API 수준이 누락되었거나 1 미만입니다.</string>
    <string name="max_plugins_reason_ApiTooNew">선언된 API 레벨은 이 빌드가 이해하는 것보다 최신이므로 전혀 실행되지 않습니다.</string>
    <string name="max_plugins_reason_MissingKind">매니페스트에는 종류가 없다고 선언되어 있습니다.</string>
    <string name="max_plugins_reason_UnknownKind">종류는 공개된 종류가 아닙니다.</string>
    <string name="max_plugins_reason_UnknownCapability">해당 기능은 이 계약의 일부가 아닙니다. 알 수 없는 기능은 무시되기보다는 거부되므로 요청한 것보다 적은 권한으로 실행되는 것은 없습니다.</string>
    <string name="max_plugins_reason_NoCapabilities">플러그인은 하나 이상의 기능을 선언해야 합니다.</string>
    <string name="max_plugins_reason_DuplicateId">이 ID를 가진 다른 플러그인이 이미 승인되었으므로 이 플러그인은 사용되지 않습니다.</string>
    <string name="max_plugins_help_title">왜 계약을 맺는가?</string>
    <string name="max_plugins_help_body">게시된 계약이 없으면 이 앱을 확장하는 사람은 누구나 내부 파일의 모양을 추측해야 하며 손상된 파일과 유효한 확장자를 구분할 수 없습니다. 이를 통해 한계가 명시됩니다. 플러그인은 의도를 선언하고 읽습니다. 하드웨어를 작성하지 않으며 위의 모든 거부는 실패한 정확한 필드의 이름을 지정합니다.</string>
</resources>

    <string name="max_perms_picker_title">앱을 선택하세요</string>
    <string name="max_perms_picker_desc">이 기기의 모든 앱에는 선언된 권한과 시스템이 실제로 허용하는 앱 작업이 포함됩니다.</string>
    <string name="max_perms_search_hint">앱 이름 또는 패키지로 검색</string>

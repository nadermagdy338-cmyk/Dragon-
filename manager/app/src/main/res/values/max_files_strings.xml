    <!-- الشرح -->
    <string name="max_files_help_title">How this screen decides</string>
    <string name="max_files_help_body">Entries come from one stat pass with a fixed tab-separated format, so ls output is never parsed for data. Anything not measured is shown as unknown rather than as zero. Every operation is guarded before it reaches the shell: a folder cannot be copied into itself, a move cannot target its own source, and the filesystem root cannot be deleted.</string>


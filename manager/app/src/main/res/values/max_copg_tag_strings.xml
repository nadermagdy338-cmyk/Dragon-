<resources>
    <string name="copg_tags_title">COPG options</string>
    <string name="copg_tags_desc">Saved as intent and written together with the device profile. Only the four comfort options work on every COPG version; the rest need COPG 6.8.0 or newer. PRO options need a COPG PRO license, and the engine may ignore them.</string>
    <string name="copg_tier_pro">PRO</string>
    <string name="copg_footprint_resident">stays in the app\'s memory, never use with anti-cheat games</string>
    <string name="copg_need_ack">acknowledge the risk below first</string>
    <string name="copg_tag_refused">A selected COPG option is not allowed for the installed COPG version. Nothing was written.</string>
    <string name="copg_tag_needs_device">Options are written with a device profile, and this app has none yet.</string>
    <string name="copg_tag_value_hint">Value</string>
    <string name="copg_tag_bad_value">Letters, digits, space and . _ - / + only (up to 60)</string>

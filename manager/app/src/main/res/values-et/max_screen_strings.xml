    <string name="appfeature_touch_title">Puudutage valikut Vastuseprofiil</string>
    <string name="appfeature_touch_summary">Responsive võimaldab saadaoleva puutevõimenduse, kui see rakendus on keskendunud; Aku teadlik hoiab selle välja. Follow ROM austab globaalset seadet ja ühilduvat mängutuvastust.</string>

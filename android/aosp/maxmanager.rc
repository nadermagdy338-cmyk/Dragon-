# service definition for the MaxManager daemon
#
# الاسم الرسمي الوحيد هو `sys.maxmanager-service` — نفس الثنائيّ الذي يبنيه
# `archdaemon/jni/Android.mk` (LOCAL_MODULE) ويشغّله الموديول من `system/bin/`.
# ولا يوجد اسم ثانٍ (`maxmanager_daemon`) ولا مسار ثانٍ (`/vendor/bin`).
service sys.maxmanager-service /system/bin/sys.maxmanager-service
    class main
    user root
    group root system
    capabilities NET_ADMIN SYS_ADMIN
    seclabel u:r:maxmanager:s0
    disabled

on property:sys.boot_completed=1
    start sys.maxmanager-service

on property:maxmanager.enable=1
    start sys.maxmanager-service

on property:maxmanager.enable=0
    stop sys.maxmanager-service